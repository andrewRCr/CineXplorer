{
  // markdownlint-cli2 configuration
  // Updated 2025-10-20: Re-enabled MD007, MD013, MD032 for better readability

  "config": {
    "default": true,
    "MD007": {
      "indent": 4
    },
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false
    },
    "MD024": {
      "siblings_only": true
    },
    "MD025": false,
    "MD029": false,
    "MD033": false,
    "MD036": false,
    "MD040": false,
    "MD041": false
  },

  "gitignore": false,

  "globs": [
    "**/*.md"
  ],

  "ignores": [
    "**/node_modules/**",
    "**/.venv*/**",
    "**/venv/**",
    "**/frontend/build/**",
    "**/frontend/.next/**",
    "**/backend/staticfiles/**",
    ".arc/reference/archive/**",
    ".arc/upcoming/prds/prd-backend-modernization.md",
    "README.md"
  ],

  "customRules": [],
  "overrides": []
}
