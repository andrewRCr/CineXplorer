{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"type-check": "tsc -b",
		"generate-types": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 openapi-typescript https://localhost:8444/api/openapi.json -o src/types/api.ts",
		"export-schema": "curl -k https://localhost:8444/api/openapi.json -o openapi.json",
		"generate-types:ci": "openapi-typescript openapi.json -o src/types/api.ts",
		"update-types": "npm run export-schema && npm run generate-types:ci",
		"ci:generate-types": "test -f openapi.json && npm run generate-types:ci || echo 'Warning: openapi.json not found'",
		"validate-types": "tsc --noEmit src/types/api.ts"
	},
	"dependencies": {
		"@chakra-ui/react": "^3.22.0",
		"@chakra-ui/tag": "^3.1.1",
		"@emotion/react": "^11.14.0",
		"@types/lodash": "^4.17.20",
		"axios": "^1.10.0",
		"formik": "^2.4.6",
		"lodash": "^4.17.21",
		"next-themes": "^0.4.6",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-icons": "^5.5.0",
		"react-router-dom": "^7.6.3",
		"use-deep-compare-effect": "^1.8.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.29.0",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.0.11",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.5.2",
		"@vitest/ui": "^3.2.4",
		"cross-env": "^7.0.3",
		"eslint": "^9.29.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.2.0",
		"jsdom": "^27.0.0",
		"msw": "^2.11.2",
		"openapi-typescript": "^7.4.1",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.34.1",
		"vite": "^7.0.0",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.2.4"
	},
	"optionalDependencies": {
		"@rollup/rollup-darwin-arm64": "^4.32.0",
		"@rollup/rollup-darwin-x64": "^4.32.0",
		"@rollup/rollup-linux-arm64-gnu": "^4.32.0",
		"@rollup/rollup-linux-x64-gnu": "^4.32.0",
		"@rollup/rollup-linux-x64-musl": "^4.32.0",
		"@rollup/rollup-win32-arm64-msvc": "^4.32.0",
		"@rollup/rollup-win32-x64-msvc": "^4.32.0"
	}
}
