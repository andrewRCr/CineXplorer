# Compose deployment inputs. Keep the real file outside the checkout at mode 600.
IMAGE_TAG=sha-0123456
# Bare host only: no scheme, port or path.
SITE_ADDRESS=staging.example.com
BACKEND_ENV_FILE=/opt/cinexplorer/backend.env

ADMIN_BASIC_AUTH_USER=replace-with-admin-user
# Generate with: docker run --rm -it caddy:2.11-alpine caddy hash-password
# Keep the bcrypt hash in single quotes so Compose preserves its dollar signs.
ADMIN_BASIC_AUTH_HASH='$2a$14$replace-with-bcrypt-hash'

# These credentials reach both database and backend through Compose.
POSTGRES_DB=cinexplorer
POSTGRES_USER=cinexplorer
POSTGRES_PASSWORD=replace-with-strong-password
