{
  // markdownlint-cli2 configuration
  // MD034 (bare URLs) enforced across all documentation
  // All file references should use proper markdown links

  "config": {
    "default": true,
    "MD007": {
      "indent": 4
    },
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD029": false,
    "MD032": false,
    "MD033": false,
    "MD036": false,
    "MD040": false,
    "MD041": false
  },

  "gitignore": false,

  "globs": [
    "**/*.md"
  ],

  "ignores": [
    "**/node_modules/**",
    "**/.venv*/**",
    "**/venv/**",
    "**/frontend/build/**",
    "**/frontend/.next/**",
    "**/backend/staticfiles/**"
  ],

  "customRules": [],
  "overrides": []
}
