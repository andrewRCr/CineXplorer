# Development and CI dependencies.
# Edit this file, then run ./lock.sh to regenerate its hashed lock, req.dev.txt, which is what
# gets installed.

-c req.txt
-r req.in

ruff >= 0.17.0, < 0.18
django-debug-toolbar >= 5.2.0, < 5.3
django-extensions >= 4.1, < 5.0
werkzeug >= 3.1.3, < 4.0
pyOpenSSL >= 26.4.0, < 27.0  # runserver_plus serves HTTPS with it
watchdog >= 4.0.0, < 5.0

# Test coverage
coverage >= 7.4.0, < 8.0
django-coverage-plugin >= 3.1.0, < 4.0

# pytest testing framework
pytest >= 9.0.3, < 10.0
pytest-django >= 4.9.0, < 5.0  # Django integration for pytest
pytest-xdist >= 3.6.0, < 4.0  # Parallel test execution
pytest-cov >= 7.1.0, < 8.0  # Coverage integration for pytest
freezegun >= 1.5.0, < 2.0  # Time manipulation for testing token expiration

# Dependency locking and auditing
uv >= 0.13.6, < 0.14  # Compiles the locks (./lock.sh)
pip-audit >= 2.10.1, < 3.0  # Checks the locks for known vulnerabilities
