#!/bin/bash
# Git pre-push hook - Runs before a push is sent
# Location: .githooks/pre-push
#
# Setup: git config core.hooksPath .githooks
# NOTE: Never use --no-verify to bypass hooks. Fix the issue instead.
#
# Code reaches main only through a pull request with passing CI. Planning records
# under .arc/ may be pushed to main directly. This hook refuses a push to main if
# any new commit, or the resulting tree, changes a path outside .arc/. Pushes to
# other branches pass untouched; `gh pr merge` merges on GitHub and never runs it.

set -euo pipefail

RED='\033[0;31m'
NC='\033[0m'

PROTECTED_REF="refs/heads/main"
MAX_LISTED=10

refuse() {
    echo -e "${RED}❌ Push to main refused: $1${NC}" >&2
    shift
    for line in "$@"; do
        echo "   $line" >&2
    done
    exit 1
}

paths_file=$(mktemp)
trap 'rm -f "$paths_file"' EXIT

while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "$PROTECTED_REF" ] || continue

    if [[ "$local_sha" =~ ^0+$ ]]; then
        refuse "main cannot be deleted."
    fi
    if [[ "$remote_sha" =~ ^0+$ ]]; then
        refuse "the remote has no main to compare against."
    fi
    if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        refuse "the remote's main has commits this checkout lacks." \
            "Fetch and integrate ${1:-origin}/main, then push again."
    fi

    # What main's tree gains, plus every path each new commit touches. Renames are
    # split so a move into .arc/ still reports the path it left.
    if ! git diff --name-only --no-renames -z "$remote_sha" "$local_sha" >"$paths_file" ||
        ! git log --format= --name-only --no-renames --no-merges -z "$remote_sha..$local_sha" >>"$paths_file"; then
        refuse "could not list the changes being pushed."
    fi

    outside=()
    while IFS= read -r -d '' path; do
        case "$path" in
            "" | .arc/*) ;;
            *) outside+=("$path") ;;
        esac
    done < <(sort -zu "$paths_file")

    if [ "${#outside[@]}" -gt 0 ]; then
        listed=("${outside[@]:0:$MAX_LISTED}")
        if [ "${#outside[@]}" -gt "$MAX_LISTED" ]; then
            listed+=("... and $((${#outside[@]} - MAX_LISTED)) more")
        fi
        refuse "it changes paths outside .arc/:" "${listed[@]}" "" \
            "Code reaches main through a pull request. Push a branch and open one instead."
    fi
done

exit 0
