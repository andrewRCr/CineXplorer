# Set the default behavior to automatically handle text files.
# Git will normalize all text files to LF endings in the repository
# and convert them to the OS-native endings upon checkout.
* text=auto

# Force LF endings for files that must work consistently across Windows/Linux
# (especially important for Docker containers and CI/CD)
*.sh eol=lf
*.bash eol=lf
*.py eol=lf
*.js eol=lf
*.ts eol=lf
*.tsx eol=lf
*.jsx eol=lf
*.css eol=lf
*.scss eol=lf
*.json eol=lf
*.yml eol=lf
*.yaml eol=lf
*.toml eol=lf
*.ini eol=lf
*.cfg eol=lf
*.conf eol=lf
*.env eol=lf
*.env.* eol=lf

# Docker and container files (must use LF for Linux containers)
Dockerfile eol=lf
Dockerfile.* eol=lf
*.dockerfile eol=lf
docker-compose*.yml eol=lf
docker-compose*.yaml eol=lf

# Configuration files that should be consistent across platforms
.gitignore eol=lf
.gitattributes eol=lf
.editorconfig eol=lf
.flake8 eol=lf
.eslintrc* eol=lf
.prettierrc* eol=lf
tsconfig*.json eol=lf
pyproject.toml eol=lf
setup.py eol=lf
requirements*.txt eol=lf
package*.json eol=lf

# Documentation files
*.md eol=lf
*.rst eol=lf
*.txt eol=lf

# Template files
*.html eol=lf
*.xml eol=lf
*.svg eol=lf

# Binary files that should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.tar.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
