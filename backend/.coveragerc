[run]
source = .
omit =
    */venv/*
    */virtualenv/*
    */site-packages/*
    */migrations/*
    */tests/*
    */test_*.py
    manage.py
    */settings/*
    */config/wsgi.py
    */config/asgi.py
    */config/__init__.py
    */__pycache__/*
    .git/*
    */node_modules/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == "__main__":
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

show_missing = True
skip_covered = False
precision = 2

[html]
directory = htmlcov