# Frontend environment (Vite). Copy to .env for local development.
# VITE_ variables are bundled into client code: never put secrets here.

# Same-origin entry point served by Caddy (infrastructure/Caddyfile)
VITE_BASE_URL="https://localhost:8444"
VITE_BASE_API_URL="${VITE_BASE_URL}/api"

# Optional overrides for environment detection in src/services/logger.ts
# VITE_APP_ENV=staging
# VITE_NODE_ENV=development
