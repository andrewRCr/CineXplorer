{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "type-check": "tsc -b",
    "typegen": "chakra typegen ./src/theme/index.ts",
    "generate-types:local": "npm ci --prefix tools/api-types && npm run generate --prefix tools/api-types",
    "generate-types": "node scripts/export-openapi.js && npm run generate-types:local",
    "generate-types:ci": "test -f openapi.json || (echo '❌ ERROR: openapi.json not found. Run generate-types first.' && exit 1); npm run generate-types:local",
    "update-types": "npm run generate-types",
    "validate-generated-types": "npm run type-check",
    "verify-contrast": "tsx scripts/verify-theme-contrast.ts",
    "verify-contrast:ci": "tsx scripts/verify-theme-contrast.ts",
    "test:auth-browser": "node scripts/check-auth-renewal-browser.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.23",
    "@types/lodash": "^4.17.27",
    "axios": "^1.10.0",
    "formik": "^2.4.9",
    "lodash": "^4.17.21",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@chakra-ui/cli": "3.38.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "^17.14.0",
    "jsdom": "^27.0.0",
    "msw": "^2.11.2",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wcag-contrast": "^3.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.66.0",
    "@rollup/rollup-darwin-x64": "^4.66.0",
    "@rollup/rollup-linux-arm64-gnu": "^4.66.0",
    "@rollup/rollup-linux-x64-gnu": "^4.66.0",
    "@rollup/rollup-linux-x64-musl": "^4.66.0",
    "@rollup/rollup-win32-arm64-msvc": "^4.66.0",
    "@rollup/rollup-win32-x64-msvc": "^4.66.0"
  },
  "overrides": {
    "@chakra-ui/cli": {
      "zod": "^4.6.6"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
