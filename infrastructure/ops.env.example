# Copy outside the checkout to /opt/cinexplorer/ops.env, owned by deploy at mode 600.
# systemd reads this file; for commands by hand, export it with set -a before sourcing.
# Use NAME=value or single quotes, without export statements or shell commands.
# Use a private R2 bucket and an Object Read & Write token scoped only to that bucket.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# The account's S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_REGION=auto
# Scoped object tokens cannot create buckets; the bucket is provisioned separately.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
R2_BUCKET=
R2_PREFIX=
# Separate Healthchecks.io ping URLs, each expecting a daily ping with two hours' grace.
BACKUP_PING_URL=
MAINTENANCE_PING_URL=
