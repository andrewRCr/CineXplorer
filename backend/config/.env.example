# Django Configuration
# ⚠️ PRODUCTION WARNING: Set DEBUG=False in production to prevent leaking sensitive info and stack traces
DEBUG=True

# Generate a secure secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# NEVER commit the real secret key - use environment variables or a secrets manager in production
DJANGO_SECRET_KEY=your-secret-key-here

# Environment Configuration (controls security settings)
# Valid values: development, staging, production
# - development: HTTP allowed, no HSTS, relaxed security (default)
# - staging: HTTPS required, short HSTS (1 hour), balanced security for testing
# - production: HTTPS required, full HSTS (1 year + preload), maximum security
ENVIRONMENT=development

# TMDB API
TMDB_API_KEY=your-tmdb-api-key

# Backend URL
BACKEND_URL=http://127.0.0.1:9000/api

# PostgreSQL Environment Variables
POSTGRES_DB=cinexplorer_dev
POSTGRES_USER=cinexplorer_user
POSTGRES_PASSWORD=cinexplorer_dev_pass

# Email Service (ZeptoMail)
# Full Authorization value: prefix plus the agent's Send Mail Token.
ZEPTOMAIL_API_KEY='Zoho-enczapikey your-zeptomail-send-mail-token'
ZEPTOMAIL_SENDER_EMAIL=your-sender@yourdomain.com

# Email verification expiry (days) - default: 3 days
# Adjust based on environment: development (1-3), staging (3), production (3-7)
EMAIL_VERIFICATION_EXPIRY_DAYS=3

# Frontend URL (for CORS and email links)
FRONTEND_URL=https://localhost:8444

# OAuth Configuration (django-allauth)
# Staging/production read these complete pairs into settings apps; neither value means
# unconfigured, and a partial pair fails startup. Development ignores all four variables
# and uses Social Applications in Django admin. Do not also create database apps for a
# provider configured in settings: allauth rejects that duplicate configuration.
# Google OAuth - Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth - Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Redis Configuration (for rate limiting and future Celery tasks)
REDIS_URL=redis://redis:6379/0

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production, ensure these settings are configured:
#
# 1. Security Settings:
#    - ENVIRONMENT=production (use staging on the staging host)
#    - DEBUG=False
#    - DJANGO_SECRET_KEY=<generated-secure-key>
#    - GUNICORN_WORKERS=2
#    - GUNICORN_THREADS=4
#
# 2. Environment-Specific Behavior (controlled by ENVIRONMENT):
#    - SESSION_COOKIE_SECURE=True (HTTPS only cookies)
#    - CSRF_COOKIE_SECURE=True (HTTPS only CSRF token)
#    - SECURE_HSTS_SECONDS=31536000 in production; 3600 in staging
#    - SECURE_HSTS_INCLUDE_SUBDOMAINS=True in production only
#    - SECURE_HSTS_PRELOAD=True in production only
#    - SECURE_SSL_REDIRECT=True (force HTTPS)
#
# 3. Email Configuration:
#    - ZEPTOMAIL_API_KEY='Zoho-enczapikey <agent-send-mail-token>'
#    - ZEPTOMAIL_SENDER_EMAIL=<verified-sender>
#
# 4. Database:
#    - Set POSTGRES_DB, POSTGRES_USER and POSTGRES_PASSWORD in the Compose env file
#    - Ensure PostgreSQL is not publicly accessible
#
# 5. OAuth Credentials:
#    - In the backend env file: GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
#    - In the backend env file: GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET
#    - Use deployed provider apps; leave the development database apps in development
#    - Update callback URLs in OAuth provider dashboards
#
# 6. URLs:
#    - Set the bare SITE_ADDRESS in the Compose env file
#    - Compose derives allowed hosts and both site URLs from SITE_ADDRESS
#    - Same-origin deployments need no CSRF_TRUSTED_ORIGINS or CORS_ALLOWED_ORIGINS
#    - Compose also supplies REDIS_URL; omit these derived values from the backend env file
#
# 7. Maintenance Tasks:
#    - cinexplorer-backup.timer copies and uploads the database nightly
#    - cinexplorer-maintenance.timer runs flushexpiredtokens and clearsessions nightly
#    - Bootstrap installs/enables both timers; their settings live in /opt/cinexplorer/ops.env
#    - Docker rotates stdout/stderr logs; no application log files are created
#
# 8. Verify Production Settings:
#    - Run: python manage.py check --deploy
#    - Review all security warnings
#    - Test HTTPS redirect and HSTS headers
