{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"type-check": "tsc -b",
		"typegen": "chakra typegen ./src/theme/index.ts",
		"generate-types:local": "openapi-typescript openapi.json -o src/types/api.ts",
		"generate-types": "node scripts/export-openapi.js && npm run generate-types:local",
		"generate-types:ci": "test -f openapi.json || (echo '❌ ERROR: openapi.json not found. Run generate-types first.' && exit 1); npm run generate-types:local",
		"update-types": "npm run generate-types",
		"validate-generated-types": "tsc --noEmit src/types/api.ts",
		"verify-contrast": "tsx scripts/verify-theme-contrast.ts",
		"verify-contrast:ci": "tsx scripts/verify-theme-contrast.ts"
	},
	"dependencies": {
		"@chakra-ui/react": "^3.28.0",
		"@chakra-ui/tag": "^3.1.1",
		"@emotion/react": "^11.14.0",
		"@tanstack/react-query": "^5.90.12",
		"@tanstack/react-query-devtools": "^5.90.12",
		"@tanstack/react-virtual": "^3.13.13",
		"@types/lodash": "^4.17.20",
		"axios": "^1.10.0",
		"formik": "^2.4.6",
		"lodash": "^4.17.21",
		"next-themes": "^0.4.6",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-icons": "^5.5.0",
		"react-router-dom": "^7.6.3",
		"use-deep-compare-effect": "^1.8.1"
	},
	"devDependencies": {
		"@chakra-ui/cli": "3.29.0",
		"@eslint/js": "^9.29.0",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.5.2",
		"@vitest/coverage-v8": "^4.1.12",
		"@vitest/ui": "^4.1.12",
		"cross-env": "^7.0.3",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.2.0",
		"jsdom": "^27.0.0",
		"msw": "^2.11.2",
		"openapi-typescript": "7.4.1",
		"prettier": "3.9.10",
		"tsx": "^4.20.6",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.34.1",
		"vite": "^7.0.0",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.12",
		"wcag-contrast": "^3.0.0"
	},
	"optionalDependencies": {
		"@rollup/rollup-darwin-arm64": "^4.32.0",
		"@rollup/rollup-darwin-x64": "^4.32.0",
		"@rollup/rollup-linux-arm64-gnu": "^4.32.0",
		"@rollup/rollup-linux-x64-gnu": "^4.32.0",
		"@rollup/rollup-linux-x64-musl": "^4.32.0",
		"@rollup/rollup-win32-arm64-msvc": "^4.32.0",
		"@rollup/rollup-win32-x64-msvc": "^4.32.0"
	}
}
