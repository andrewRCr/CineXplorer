# Runtime dependencies shared by every environment.
# Edit this file, then run ./lock.sh to regenerate its hashed lock, req.txt, which is what
# gets installed.

Django >= 5.2.1, < 5.3
psycopg >= 3.2.9, < 3.3
django-environ >= 0.14.0, < 0.15
django-cors-headers >= 4.9.0, < 4.10
django-ninja-jwt >= 5.4.0, < 5.5
django-ninja >= 1.6, < 2.0
django-allauth >= 65.11.2, < 66.0
django-zoho-zeptomail == 0.0.4  # Multipart conversion used by the project email backend
redis >= 5.3.1, < 5.4  # Cache backend for Django Ninja throttling + future Celery broker

# Type checking - Pyright-only approach
django-types == 0.24.0  # Pyright-compatible Django stubs

whitenoise >= 6.12.0, < 6.13  # Static files in deployed environments
gunicorn >= 26.2.0, < 26.3  # WSGI server for deployed environments
email-validator >= 2.0.0, < 3.0  # Required for Pydantic EmailStr validation
python-json-logger >= 4.2.0, < 4.3  # Structured production logs with escaped messages and extra fields

# Imported directly by the project, not only through the packages above
requests >= 2.34.2, < 3.0  # TMDB client sessions
urllib3 >= 2.8.0, < 3.0  # Retry policy for the TMDB client
PyJWT >= 2.15.1, < 3.0  # Token decoding in the authentication utilities
pydantic >= 2.14.2, < 3.0  # API schemas
