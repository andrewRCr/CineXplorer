{
    // CineXplorer Backend - Pyright Configuration for Development
    //
    // Type safety approach: Pyright-only with django-types
    // - Pyright: All type checking (local + CI)
    // - django-types 0.22.0: Pyright-compatible Django stubs
    //
    // Usage: `npx pyright apps/` or via IDE integration
    // For comprehensive checking: `python scripts/type_check.py`

    "include": ["apps", "config"],
    "exclude": [
        "**/__pycache__",
        "**/*.pyc",
        "**/migrations/**",
        "**/node_modules/**",
        "**/.venv/**",
        "**/venv/**",
        "**/env/**",

        // TEMPORARY EXCLUSIONS: Legacy DRF Code (API Migration)
        // TODO: Remove exclusions in api-layer-p2 after files deleted
        // Tracked in: prd-api-layer-modernization-p2.md
        "apps/authentication/views.py",
        "apps/authentication/urls.py",  // Legacy DRF URL mappings (references excluded views.py)
        "apps/authentication/serializers.py",
        "apps/authentication/authenticate.py",  // Legacy DRF JWT auth (unused, uses rest_framework_simplejwt)
        "apps/user_movie_data/views.py",
        "apps/user_movie_data/serializers.py",
        "apps/user_movie_data/urls.py",  // Legacy DRF router (uses rest_framework)
        "apps/user_movie_data/services/user_movie_data_service.py",
        "apps/movie/tests/test_paginated_views.py",
        "apps/user_movie_data/tests/test_user_movie_data_api.py",
        "apps/core/views/logging.py",
        "apps/core/views/tmdb.py",
        "apps/core/urls.py"  // Legacy DRF URL mappings (references excluded views)
    ],
    "extraPaths": ["apps"],
    "venvPath": "..",
    "venv": ".venv-backend",
    "reportMissingImports": "error",
    "reportMissingTypeStubs": "information",
    "reportMissingModuleSource": "none",
    "pythonVersion": "3.13",
    "strict": ["apps"],
    "typeCheckingMode": "strict",
    "reportGeneralTypeIssues": "error",
    "reportUnusedImport": "warning",
    "reportUnusedClass": "warning",
    "reportUnusedFunction": "warning",
    "reportUnusedVariable": "warning",
    "reportImportCycles": "error",
    "reportPrivateUsage": "error",
    "reportAny": "warning",

    // Django ORM limitations (acceptable information-level warnings)
    // These patterns are inherent to Django's dynamic ORM and validated at runtime by tests
    // Reference: .arc/reference/strategies/strategy-type-safety.md
    "reportUnknownMemberType": "information",
    "reportUnknownParameterType": "warning",
    "reportUnknownArgumentType": "information",
    "reportUnknownVariableType": "information",
    "reportAttributeAccessIssue": "information",
    "reportMissingTypeArgument": "error",

    // Custom stub files for third-party libraries
    // Located in backend/stubs/ - supplements django-types for allauth, ninja_jwt, etc.
    "stubPath": "stubs"
}