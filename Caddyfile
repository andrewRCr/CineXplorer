https://localhost:8443 {
    tls /etc/caddy/cert.pem /etc/caddy/key.pem

    reverse_proxy /api/* backend:8000 {
        transport http {
            tls
            tls_insecure_skip_verify
        }
    }
    reverse_proxy frontend:5173 {
        transport http {
            tls
            tls_insecure_skip_verify
        }
    }
}
