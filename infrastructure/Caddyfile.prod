# Django sends the four security headers the site block sets; drop its copies so each response carries one.
# A repeated Cross-Origin-Opener-Policy does not parse, and browsers then ignore it.
(backend) {
	reverse_proxy backend:8000 {
		header_down -X-Content-Type-Options
		header_down -X-Frame-Options
		header_down -Referrer-Policy
		header_down -Cross-Origin-Opener-Policy
	}
}

{$SITE_ADDRESS} {
	root * /srv

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Cross-Origin-Opener-Policy same-origin
	}

	handle /admin/* {
		basic_auth {
			{$ADMIN_BASIC_AUTH_USER} {$ADMIN_BASIC_AUTH_HASH}
		}
		import backend
	}

	@backend path /api/* /_allauth/* /accounts/* /static/*
	handle @backend {
		import backend
	}

	handle /assets/* {
		@asset {
			file
			not path */
		}
		handle @asset {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			header Cache-Control no-store
			respond 404
		}
	}

	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
