# Node.js modules (shouldn't be in backend but excluding from build context)
node_modules/

# Python cache and temp files
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/

# Python build and packaging artifacts
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/

# Test and CI artifacts
.tox/
.eggs/

# Python version management
.python-version

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
*.env
*.env.*
.env
.env.*

# SSL/TLS certificates and private keys
*.key
*.pem
*.crt
*.p12
*.jks

# SSH keys
id_rsa
id_dsa
.ssh/

# Generic secrets and credentials
private_key*
credentials*
secret*
*.k8s.yaml

# Git
.git
.gitignore